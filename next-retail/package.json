{
  "name": "aroma-erp-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "local:prepare": "node scripts/local-prepare.mjs",
    "local:catalog": "node scripts/import-local-catalog.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/nextjs-registry": "1.3.0",
    "antd": "6.6.7",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.0.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.0",
    "iron-session": "^9.0.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
